{
  "$schema": "https://raw.githubusercontent.com/davecthomas/ai-api-unified/main/src/ai_api_unified/schemas/models.schema.json",
  "service": "ai-api-unified-http",
  "allow": [],
  "deny": [],
  "completions": {
    "engine": "claude",
    "fallbacks": [],
    "fallback_on": "unavailable,rate_limited,quota_exhausted,auth_rejected",
    "retry_policy": "default",
    "thinking": "medium",
    "cooldown": true
  },
  "model_check": {
    "mode": "prune",
    "timeout_seconds": 10
  },
  "embeddings": {
    "engine": "google-gemini",
    "model": "gemini-embedding-001"
  },
  "voice": {
    "engine": "openai"
  },
  "providers": {
    "google": {
      "auth_method": "api_key"
    }
  },
  "middleware": [
    {
      "name": "observability",
      "enabled": true,
      "settings": {
        "direction": "input_output",
        "log_level": "INFO",
        "emit_cost": true,
        "include_provider_usage": true,
        "emit_error_events": true
      }
    },
    {
      "name": "pii_redaction",
      "enabled": false,
      "settings": {
        "direction": "input_only",
        "strict_mode": false,
        "detection_profile": "balanced",
        "language": "en",
        "country_scope": "US"
      }
    }
  ]
}
