{
  "$schema": "https://raw.githubusercontent.com/davecthomas/ai-api-unified/main/src/ai_api_unified/schemas/models.schema.json",
  "service": "ai-api-unified-http",
  "allow": [],
  "deny": [],
  "completions": {
    "engine": "claude",
    "fallbacks": [],
    "fallback_on": "unavailable,rate_limited,quota_exhausted,auth_rejected",
    "retry_policy": "default",
    "thinking": "medium",
    "cooldown": true
  },
  "model_check": {
    "mode": "prune",
    "timeout_seconds": 10
  },
  "embeddings": {
    "engine": "google-gemini",
    "model": "gemini-embedding-001"
  },
  "images": {
    "engine": "google-gemini",
    "model": "imagen-4.0-ultra-generate-001"
  },
  "videos": {
    "engine": "google-gemini",
    "model": "veo-3.1-lite-generate-preview"
  },
  "voice": {
    "engine": "openai"
  },
  "providers": {
    "google": {
      "auth_method": "api_key"
    }
  },
  "middleware": [
    {
      "name": "observability",
      "enabled": true,
      "settings": {
        "direction": "input_output",
        "log_level": "INFO",
        "emit_cost": true,
        "include_provider_usage": true,
        "emit_error_events": true
      }
    },
    {
      "name": "response_cache",
      "enabled": true,
      "settings": {
        "max_entries": 10000,
        "operations": {
          "completions": {
            "ttl_seconds": 3600
          },
          "structured_output": {
            "ttl_seconds": 3600
          },
          "conversation": {
            "ttl_seconds": 3600
          },
          "embeddings": {
            "ttl_seconds": 86400
          },
          "classification": {
            "ttl_seconds": 86400
          }
        }
      }
    },
    {
      "name": "guardrails",
      "enabled": false,
      "settings": {
        "on_fail": "block",
        "on_error": "block",
        "prompt_injection": {
          "threshold": 0.8,
          "direction": "input_only"
        },
        "harmful_content": {
          "backend": "auto",
          "threshold": 0.8
        },
        "custom": []
      }
    },
    {
      "name": "pii_redaction",
      "enabled": false,
      "settings": {
        "direction": "input_only",
        "strict_mode": false,
        "detection_profile": "balanced",
        "language": "en",
        "country_scope": "US"
      }
    }
  ],
  "environments": {
    "dev": {
      "completions": {
        "engine": "google-gemini",
        "fallbacks": [
          "openai:gpt-4o-mini"
        ]
      }
    }
  }
}
