{
  "name": "@davecthomas/ai-api-unified-http-client",
  "version": "1.6.0",
  "description": "Typed TypeScript client for ai-api-unified-http, generated from its OpenAPI spec.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/davecthomas/ai-api-unified-http.git",
    "directory": "clients/typescript"
  },
  "scripts": {
    "build": "tsc",
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node --experimental-strip-types smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
