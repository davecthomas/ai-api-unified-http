########################################################################
#   ai-api-unified-http — service configuration
#   Copy this file to .env and fill in only the providers you use.
#   .env is gitignored; never commit real keys.
#
#   This file holds secrets and the service's own settings. Engines, default
#   models, the fallback chain, the thinking level, the voice engine, and the
#   middleware profile live in config/models.json, the library's models.json
#   format. Variable names are identical to the ai-api-unified library's, so
#   a .env that works for the library works here unchanged.
########################################################################

# --- Service ---
# Reserved for the deployment entrypoint; the app does not read these yet.
# The README dev command passes --port explicitly.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Python log level for the service and the library's observability events.
# The service installs a stdout handler at this level on startup; without it
# nothing the service logs about its own decisions would appear. DEBUG also
# un-quiets the provider SDK loggers, which are held at WARNING otherwise.
LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS. Default admits the local
# test web app (make webapp); deployments set their real web app origins.
# HTTP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Cost attribution ---
# Nothing to configure. Callers split spend below the API key by sending
# X-Caller-Id, and optionally X-Session-Id and X-Workflow-Id, on each request.

# --- Rate limiting (guards provider spend) ---
# Requests allowed per API key per window. The count is per worker process, so
# the effective ceiling is this times WEB_CONCURRENCY. 0 disables it.
# HTTP_RATE_LIMIT=60
# HTTP_RATE_LIMIT_WINDOW_SECONDS=60

# --- Authentication (required; the service refuses to start without it) ---
# Every /v1 endpoint spends provider credits, and callers never hold provider
# keys, so an unauthenticated endpoint is an open tab rather than a data leak.
# Comma-separated keys. Each entry is "label:key" or a bare "key"; the label
# names the calling application in logs and authenticates nothing on its own.
# Generate one with: openssl rand -hex 32
# HTTP_API_KEYS=webapp:replace-with-a-generated-secret,batch:another-secret
# Run without authentication on purpose (local development only). The service
# starts with a warning; every caller can spend provider credits.
# HTTP_AUTH_DISABLED=1

# --- Cost-event capture (required; the service refuses to start without it) ---
# Every provider call emits a cost event, and every request emits one more
# that totals its calls. The service attaches a handler to the library's cost
# topic at startup and fails loudly if nothing is listening, because a dropped
# event is spend with no record of who incurred it.
# Sink file for cost events, one JSON object per line. Parent dirs are created.
# HTTP_COST_LOG_PATH=cost-events.jsonl
# Logger the library emits cost events on. Set this only if the library's
# emit_cost_topic was retuned; otherwise capture attaches to a silent topic.
# HTTP_COST_TOPIC=ai_api_unified.observability.cost

# --- Provider credentials (fill in what you use; leave the rest blank) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
# Key for a server reached with engine "openai-compatible" (vLLM, Ollama,
# LiteLLM, a hosted vendor's compatible endpoint). Its URL and the rest of
# its settings are providers.openai_compatible in config/models.json.
# OPENAI_COMPATIBLE_API_KEY=

# --- Model selections (config/models.json) ---
# The service points the library at config/models.json when this is unset.
# Name another file (.json, .yaml, .yml) or inline JSON to use instead; blank
# turns the file off, and every selection then has to come from the keys
# below. Validate a file with:
#   poetry run python -m ai_api_unified.config_schema validate config/models.json
# AI_MODELS_CONFIG=config/models.json
# Pick an entry under "environments" in the file and merge it over the rest
# (objects merge, lists and values replace). Unset uses the file as written.
# AI_MODELS_ENV=prod
#
# The pre-3.x selection keys still work and win over the file, with one
# deprecation warning per key at startup: COMPLETIONS_ENGINE,
# COMPLETIONS_MODEL_NAME, COMPLETIONS_FALLBACKS, COMPLETIONS_FALLBACK_ON,
# COMPLETIONS_RETRY_POLICY, EMBEDDING_ENGINE, EMBEDDING_MODEL_NAME,
# AI_VOICE_ENGINE, GOOGLE_AUTH_METHOD, OPENAI_COMPATIBLE_BASE_URL,
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUT, OPENAI_COMPATIBLE_CONTEXT_WINDOW,
# AI_STRICT_DEPRECATIONS, AI_MIDDLEWARE_CONFIG_PATH. Move them into the file
# with the library's migrator (see the README). `make gcp-deploy FALLBACKS=...`
# sets COMPLETIONS_FALLBACKS this way on purpose, so a deployment can name a
# chain without editing the file.

# Largest accepted request body in bytes; 0 disables the check. The rate limit
# bounds how often a caller spends, not how much one call costs.
HTTP_MAX_REQUEST_BYTES=1048576

# Read the client address from X-Forwarded-For rather than the socket, for
# counting requests that carry no API key. Set this only behind a proxy that
# appends the address it saw; Cloud Run does.
HTTP_CLIENT_IP_FROM_XFF=0

# Where generated images and video are stored. A bucket mount in a deployment,
# any writable directory locally. Artifacts outlive the request that made them
# so a failed transfer is a re-download rather than a re-generation.
HTTP_ARTIFACT_DIR=artifacts

# How long an artifact is served. The bucket's lifecycle rule does the actual
# deleting; this stops the service serving something about to be removed.
HTTP_ARTIFACT_TTL_SECONDS=86400
